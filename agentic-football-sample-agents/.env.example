# Copy to .env and fill in values for your machine.
#   cp .env.example .env        (Linux/macOS)
#   copy .env.example .env      (Windows)
#
# NEVER commit .env — it is gitignored.
# AWS credentials can also live in ~/.aws/credentials (Settings page writes there).

# --- AWS (Workshop STS temporary credentials) ---
AWS_DEFAULT_REGION=us-east-1
AWS_ACCESS_KEY_ID=ASIAxxxxxxxxxxxxxxxx
AWS_SECRET_ACCESS_KEY=your-secret-access-key
AWS_SESSION_TOKEN=your-session-token

# --- AAFC Player Portal ---
# Workshop team code (without the "team:" prefix).
# Alternative: python portal_bot.py setup --team-code YOUR_CODE
#              (saved under .portal-profile/team_code.txt, also gitignored)
AAFC_TEAM_CODE=

# --- Optional: HTTPS proxy for Bedrock Claude (geo-restricted regions) ---
# OBSERVE_HTTPS_PROXY=http://127.0.0.1:7890
# HTTPS_PROXY=http://127.0.0.1:7890

# --- Gateway team (ai-team-strands-gateway only) ---
# GATEWAY_URL=https://your-gateway.example.com
# GATEWAY_ACCESS_TOKEN=
# GATEWAY_ROLE_ARN=arn:aws:iam::123456789012:role/YourRole
# AWS_ACCOUNT_ID=123456789012

# --- Memory team (ai-team-strands-memory only) ---
# MEMORY_ID=your-memory-id
# TEAM_ID=your-team-id
# MATCH_TAG=
